# pacod-cms behind the shared edge (pacod-caddy): the studio's site and the public websites'.
# Imported by a Caddyfile that holds the global options -- cms's own (docker/caddy/Caddyfile,
# Caddyfile.dev) or the full stack's -- so it has none, and its snippets carry cms's prefix (every
# imported fragment shares one namespace). Everything a request meets is here, so development, stage,
# production and the full stack run the same rules. Each one fails silently when dropped:
#   - Host passes through unchanged (Caddy's default): the site picks the website by it, pacod-id
#     answers only its issuer's host. X-Forwarded-Host is that Host, port included, so a redirect
#     the applications build keeps the published port.
#   - X-Real-IP is the TCP peer: the site believes it only from a proxy on a private address, which
#     Caddy is, and the crawler log verifies Googlebot by it. X-Forwarded-For is Caddy's own: it
#     REPLACES a value a client wrote rather than appending to it.
#   - X-Pacod-Print is removed: only the PDF renderer, on pacod-net, may send one;
#   - request bodies stop at 4 MiB, in step with the studio's multipart limits (Spring's 4MB is
#     4 MiB; Caddy's MB is decimal, so the unit is MiB) -- but for the studio's two restore paths,
#     which take an archive as the body, up to CMS_ARCHIVE_MAX_SIZE (2 GiB);
#   - / on the studio's host answers 302 to /mgmt/sites;
#   - /_internal/ answers 404: those questions are asked on pacod-net only;
#   - each request is logged to stdout with sign-in codes and state, tokens, keys, Referer and the
#     response's Location removed (CMS_CADDY_LOG_FORMAT below).
#
# The addresses come from the environment, a developer machine's by default:
#   CMS_STUDIO_SITE   the studio's site address(es). cms standalone: `http://<STUDIO_HOST>,
#                     https://<STUDIO_HOST>` on dev, `https://<STUDIO_HOST>` on stage and prod (the
#                     Makefile derives it); the full stack: http://studio.<domain>:<port>.
#   CMS_PUBLIC_SITE   every other host: the public websites, the edge's ONLY catch-all. cms
#                     standalone: `http://, https://` on dev, `https://` on stage and prod; the full
#                     stack: http://:<port>.
#   CMS_PUBLIC_TLS    `import cms-on-demand-tls` where the Caddyfile's global options ask the site
#                     before an on-demand certificate (cms standalone always sets it); unset, the
#                     catch-all carries no TLS directive (the full stack, HTTP only).
#   CMS_STUDIO_TLS    a TLS directive for the studio's site; unset, none (Caddy's default).
#   CMS_PUBLIC_EXTRA  directives for the websites' site before it proxies, such as the redirects of
#                     a website's old addresses; unset, none.
# Behind a Caddy that already runs on the host (PROXY_MODE=external), scripts/caddy-config.sh writes
# this file with the placeholders filled in -- that Caddy has none of these variables -- and
# CMS_PUBLIC_SITE names the websites' hosts instead of catching every host.
#   CMS_CADDY_LOG_FORMAT  the access log's format, `json` (the default) or `console` (Caddy's text);
#                     every site importing cms-front logs each request to stdout in it, with
#                     sign-in codes, tokens and keys removed (pacod-demo/docs/LOGGING.md, section 6).
# A variable set to the empty string is used as such, not replaced by the default: leave it unset.

(cms-forward) {
	header_up X-Real-IP {remote_host}
	header_up -X-Pacod-Print
}

(cms-front) {
	# Each request, to stdout (pacod-demo/docs/LOGGING.md, section 6), in CMS_CADDY_LOG_FORMAT. The
	# query parameters and headers that carry sign-in codes, tokens and keys are removed -- the
	# studio's and pacod-id's sign-in round trips put `code` and `state` in the address, and a
	# Referer repeats an address whole. Caddy itself leaves out Cookie, Set-Cookie and Authorization.
	log {
		output stdout
		format filter {
			wrap {$CMS_CADDY_LOG_FORMAT:json}
			fields {
				request>uri query {
					delete token
					delete code
					delete state
					delete next
					delete flow
					delete id_token_hint
					delete login_hint
					delete key
				}
				request>headers>Referer delete
				request>headers>X-Api-Key delete
				request>headers>X-Goog-Api-Key delete
				resp_headers>Location delete
			}
		}
	}
	encode gzip
	@internal path /_internal/*
	respond @internal 404
}

# A website's certificate, obtained at its host's first handshake once the site says the host is an
# active website's: the Caddyfile's global options name the question (on_demand_tls { ask
# http://cms-site:8443/_internal/tls-ask }).
(cms-on-demand-tls) {
	tls {
		on_demand
	}
}

# The studio. The two restore paths take a whole website's archive as the request body (never
# multipart, which stays at 4 MiB with every other upload); the studio caps it again itself
# (pacod.archive.max-bytes), so keep CMS_ARCHIVE_MAX_SIZE in step with that.
{$CMS_STUDIO_SITE:http://studio.localhost, https://studio.localhost} {
	{$CMS_STUDIO_TLS}
	import cms-front
	@cms-archive path /mgmt/sites/restore /mgmt/organisations/restore
	@cms-upload not path /mgmt/sites/restore /mgmt/organisations/restore
	request_body @cms-archive {
		max_size {$CMS_ARCHIVE_MAX_SIZE:2GiB}
	}
	request_body @cms-upload {
		max_size 4MiB
	}
	# Relative: the browser keeps the host and port it asked with.
	redir / /mgmt/sites 302
	reverse_proxy cms-studio:7443 {
		import cms-forward
	}
}

# Every host no other site block names: the public site, which answers 404 for a host no website
# claims.
{$CMS_PUBLIC_SITE:http://, https://} {
	{$CMS_PUBLIC_TLS}
	import cms-front
	request_body {
		max_size 4MiB
	}
	{$CMS_PUBLIC_EXTRA}
	reverse_proxy cms-site:8443 {
		import cms-forward
	}
}
