<?xml version="1.0" encoding="UTF-8"?>
<!--
  No scan="true": the config ships inside the jar, so it is not reachable as a
  watchable file and logback would only warn about it on every startup.
-->
<configuration>

  <include resource="org/springframework/boot/logging/logback/defaults.xml" />
  <springProperty scope="context" name="CONSOLE_PATTERN" source="application.console-pattern"/>

  <!--
    Sourced from app.log.dir, with a relative default so a plain `java -jar` works
    anywhere. Never hardcode a path here: it would silently override every logging.*
    property in the profile files and make startup fail outright wherever that path
    is not writable.
  -->
  <springProperty scope="context" name="LOG_FOLDER" source="app.log.dir" defaultValue="./logs"/>
  <springProperty scope="context" name="log-level" source="app.log.level" defaultValue="INFO"/>
  
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d %clr([%thread]) %highlight([%-5level]) %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FOLDER}/pacod-cms-site.log</file>
    <encoder>
      <pattern>%d %clr([%thread]) %highlight([%-5level]) %logger{36} - %msg%n</pattern>
    </encoder>
    
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>
        ${LOG_FOLDER}/pacod-cms-site_%d{yyyy-MM-dd}_%i.zip
      </fileNamePattern>
      <timeBasedFileNamingAndTriggeringPolicy
              class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
        <maxFileSize>20MB</maxFileSize>
      </timeBasedFileNamingAndTriggeringPolicy>
      <maxFileSize>20MB</maxFileSize>
    </rollingPolicy>
  </appender>
  
  <logger name="org.springframework" level="WARN"/>
  
  <logger name="io.pacod" level="${log-level}" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <root level="${log-level}">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>