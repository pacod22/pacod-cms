# Production. Selected by ENV=prod (see docs/RUNNING.md and docs/DEPLOYMENT.md).
#
# The prod profile, real HTTPS (Let's Encrypt; a certificate pair of your own is possible), ports
# 80/443, the applications' and MongoDB's ports on loopback only, real mail through PID_SMTP_*, no
# mock gateway, no mail catcher, no demo websites.
#
# The machine's .env names the hosts and the mail relay and holds the secrets; `make init ENV=prod
# ...` writes it, and `make check` (run by `make up`) refuses to start while anything is missing.

SPRING_PROFILE=prod
CADDYFILE=./docker/caddy/Caddyfile
PUBLIC_SCHEME=https
# Nothing optional: name a real AI gateway in .env (PACOD_GW_URL, PACOD_GW_API_KEY), or AI stays
# off.
COMPOSE_PROFILES=

HTTP_PORT=80
HTTPS_PORT=443
WEB_PORT=8080
MGMT_PORT=7070
MONGO_PORT=27017
MAILPIT_PORT=8125
PUBLISH_IP=127.0.0.1

MONGO_DATA_DIR=/data/mongo/db
LOG_DIR_HOST=/data/logs
STORAGE_HOST=/data/storage
MONGO_BACKUP_DIR=/data/backup/pacod-cms

# An empty platform stays empty: websites are created in the studio, or with make site-create.
DEMO_WEBSITES=false
SITE=
SMOKE_DEMO=
