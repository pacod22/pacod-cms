# Development: a developer machine. Selected by ENV=dev, the default (see docs/RUNNING.md).
#
# A preset holds an environment's shape -- profile, Caddyfile, ports, paths, what runs -- and no
# secret. The Makefile and compose read it first; this machine's .env (secrets, overrides) and
# .env-local (optional) win over it. Change a value for one machine in .env, not here.

# Spring's dev profile: templates re-read on every request, plain HTTP behind Caddy.
SPRING_PROFILE=dev
# Plain HTTP on HTTP_PORT; HTTPS on HTTPS_PORT from Caddy's own local CA, which no browser trusts.
CADDYFILE=./docker/caddy/Caddyfile.dev
PUBLIC_SCHEME=http
# The mock AI gateway (pacod-gw-lite and its mock providers) and the mail catcher.
COMPOSE_PROFILES=dev-gateway,mailpit

HTTP_PORT=8000
HTTPS_PORT=8443
# The applications' and MongoDB's own ports, for bypassing Caddy while debugging. Blank PUBLISH_IP:
# every interface, IPv4 and IPv6 (*.localhost resolves to ::1 first).
WEB_PORT=8080
MGMT_PORT=7070
MONGO_PORT=27017
MAILPIT_PORT=8125
PUBLISH_IP=

# The data. MongoDB in a Docker volume: on macOS a bind mount refuses its file operations now and
# then. `make destroy` drops it.
MONGO_DATA_DIR=cms-mongo-data
LOG_DIR_HOST=./.data/logs
STORAGE_HOST=./.data/storage
MONGO_BACKUP_DIR=./.data/backup/pacod-cms

# *.localhost resolves to this machine in macOS and in current browsers; no hosts file needed.
STUDIO_HOST=studio.localhost
ID_HOST=id.localhost
PACOD_SITE_DOMAIN=localhost

# Two demo websites with demo content, created on the first start of an empty platform.
DEMO_WEBSITES=true
DEMO_HOSTS=demo.localhost,localhost
DEMO_MINIMAL_HOSTS=minimal.localhost

# The website the site-scoped targets (seed, mongo, reseed-pages, smoke) act on, and whether smoke
# expects the demo content there.
SITE=demo
SMOKE_DEMO=1
