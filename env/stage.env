# Staging: a server with domains of its own, running production's configuration, where testers
# can do anything without consequence. Selected by ENV=stage (see docs/RUNNING.md).
#
# Like production: the prod profile, real HTTPS (Let's Encrypt), ports 80/443, the applications'
# and MongoDB's ports on loopback only. Unlike it: mail is caught by mailpit (nobody real receives
# any), AI goes to the mock gateway (nothing is spent), and the demo websites are created on the
# first start. To try real mail or a real gateway, set PID_SMTP_* or PACOD_GW_* in .env.
#
# The machine's .env names the hosts (STUDIO_HOST, ID_HOST, PACOD_SITE_DOMAIN, DEMO_HOSTS,
# DEMO_MINIMAL_HOSTS) and holds the secrets; `make init ENV=stage ...` writes it.

SPRING_PROFILE=prod
CADDYFILE=./docker/caddy/Caddyfile
PUBLIC_SCHEME=https
COMPOSE_PROFILES=dev-gateway,mailpit

# Caddy obtains its certificates over these, so both must be reachable from the internet.
HTTP_PORT=80
HTTPS_PORT=443
# Loopback only: reachable on the server itself (make smoke, an SSH tunnel), not from outside.
WEB_PORT=8080
MGMT_PORT=7070
MONGO_PORT=27017
MAILPIT_PORT=8125
PUBLISH_IP=127.0.0.1

MONGO_DATA_DIR=/data/mongo/db
# cms-site.log and cms-studio.log, JSON, rotated daily and at 20MB, kept 30 days. Their stdout is
# JSON as well (APP_LOG_FORMAT unset; pacod-demo/docs/LOGGING.md).
LOG_DIR_HOST=/data/logs
STORAGE_HOST=/data/storage
MONGO_BACKUP_DIR=/data/backup/pacod-cms

# Created once, on an empty platform, at DEMO_HOSTS, DEMO_MINIMAL_HOSTS and DEMO_SPACE_HOSTS from
# .env -- which is why `make check` refuses to start stage while those still name *.localhost.
DEMO_WEBSITES=true
SITE=demo
SMOKE_DEMO=1
