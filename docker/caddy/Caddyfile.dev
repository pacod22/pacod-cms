# Caddy, the front door on a developer machine: env/dev.env sets CADDYFILE to this file.
# Stage and production use Caddyfile; the rules all three run for cms's sites are
# platform/caddy/cms.caddy, mounted in /etc/caddy/sites/ and imported below.
#
# Plain HTTP on HTTP_PORT is the way in: every address names its scheme, because a bare hostname
# would get automatic HTTPS, which redirects to https://<host>/ on port 443 -- not the port this
# machine publishes. The same hosts answer HTTPS on HTTPS_PORT with certificates from Caddy's own
# local CA (in the pacod-caddy-data volume, trusted by no browser), a website's issued on demand
# after the same /_internal/tls-ask production asks. A pair named by SSL_CERT_FILE/SSL_KEY_FILE is
# served instead for every name it covers, as in production.
{
	on_demand_tls {
		ask http://cms-site:8443/_internal/tls-ask
	}
	local_certs
	skip_install_trust
	auto_https disable_redirects
	{$CADDY_GLOBAL_OPTIONS}
}

import /etc/caddy/sites/*.caddy
{$CADDY_SUPPLIED_PAIR}

# pacod-id's public listener (see Caddyfile).
http://{$ID_HOST}, https://{$ID_HOST} {
	import cms-front
	request_body {
		max_size 1MiB
	}
	reverse_proxy pacod-id:8070 {
		import cms-forward
	}
}
