# Caddy, the front door on stage and in production (compose service `pacod-caddy` in
# docker-compose.standalone.yml; env/stage.env and env/prod.env set CADDYFILE to this file).
# Development uses Caddyfile.dev. The rules for cms's sites are platform/caddy/cms.caddy, mounted in
# /etc/caddy/sites/ and imported below; this file adds the global options, pacod-id's site and the
# supplied pair.
#
# HTTPS for every host, HTTP redirected to it. The studio's and pacod-id's hosts get their
# certificates the usual way (CMS_STUDIO_SITE is https://<STUDIO_HOST>). Every other host gets one
# ON DEMAND, at its first TLS handshake -- websites add domains in the studio without anyone
# touching this file -- but only after the site says the host is an active website's
# (/_internal/tls-ask), so nobody can make the installation ask a CA for names it does not serve.
# A pair named by SSL_CERT_FILE/SSL_KEY_FILE is served instead for every name it covers
# (CADDY_SUPPLIED_PAIR, set by compose).
#
# CADDY_GLOBAL_OPTIONS adds one line to the global block: `email ops@example.com` for the CA's
# notices, or `local_certs` to try this file without a public CA.
{
	on_demand_tls {
		ask http://cms-site:8443/_internal/tls-ask
	}
	{$CADDY_GLOBAL_OPTIONS}
}

import /etc/caddy/sites/*.caddy
{$CADDY_SUPPLIED_PAIR}

# pacod-id's public listener, Host and Origin unchanged: it answers its pages only on the issuer's
# exact host. Bodies stop at 1 MiB. Its internal listener (8071) is never routed. Not part of cms's
# fragment: the full stack routes pacod-id with pacod-id's own.
{$ID_HOST} {
	import cms-front
	request_body {
		max_size 1MiB
	}
	reverse_proxy pacod-id:8070 {
		import cms-forward
	}
}
