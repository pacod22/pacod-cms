# Caddy, the front door on stage and in production (compose service `caddy`; env/stage.env and
# env/prod.env set CADDYFILE to this file). Development uses Caddyfile.dev. The rules both run are in
# routes.caddy.
#
# HTTPS for every host, HTTP redirected to it. The studio's and pacod-id's hosts get their
# certificates the usual way. Every other host gets one ON DEMAND, at its first TLS handshake --
# websites add domains in the studio without anyone touching this file -- but only after the site
# says the host is an active website's (/_internal/tls-ask), so nobody can make the installation
# ask a CA for names it does not serve. A pair named by SSL_CERT_FILE/SSL_KEY_FILE is served
# instead for every name it covers (CADDY_SUPPLIED_PAIR, set by compose).
#
# CADDY_GLOBAL_OPTIONS adds one line to the global block: `email ops@example.com` for the CA's
# notices, or `local_certs` to try this file without a public CA.
{
	on_demand_tls {
		ask http://site:8443/_internal/tls-ask
	}
	{$CADDY_GLOBAL_OPTIONS}
}

import routes.caddy
{$CADDY_SUPPLIED_PAIR}

{$STUDIO_HOST} {
	import studio
}

{$ID_HOST} {
	import id
}

https:// {
	tls {
		on_demand
	}
	import site
}
