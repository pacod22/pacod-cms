<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.pacod</groupId>
        <artifactId>pacod-cms</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>


    <groupId>io.pacod</groupId>
    <artifactId>pacod-cms-core</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>pacod-cms-core</name>
    <description>Documents, repositories and services shared by the pacod-cms applications</description>

    <packaging>jar</packaging>


    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- TenantDirectory's host and site lookups. Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!--
          Provided, not compile: this is a shared library. It compiles against the web
          stack, but must not force an embedded container onto every consumer. Both
          consuming apps bring their own via spring-boot-starter-web.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          Annotations only, not databind. The documents here are serialized by the applications'
          JSON controllers, so they need to be able to say what must NOT go over the wire
          (Article.previousText) - but this is a shared library and has no business pulling a JSON
          mapper into consumers that may not want one. The annotations jar has no transitive
          dependencies; the consuming apps bring databind via spring-boot-starter-web.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!--
          YAML 1.2, for pacod-id's role manifests (identity.authz). Not the SnakeYAML 1.x Spring
          already carries: that reads YAML 1.1, where `yes` and `on` are booleans, and a manifest
          would then mean something pacod-id's own engine refuses.
        -->
        <dependency>
            <groupId>org.snakeyaml</groupId>
            <artifactId>snakeyaml-engine</artifactId>
            <version>2.9</version>
        </dependency>

        <!-- Jackson 3: the seed steps read their JSON with the application's ObjectMapper. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Jackson 2 databind is test-only here: ArticleTest asserts what the wire format leaves out. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
